# =============================================================
# Warranty Intelligence Agent Platform — Environment Template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================

# ---- Service ----
APP_ENV=development                       # development | staging | production
APP_NAME=warranty-intelligence-agent
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# ---- Security ----
API_KEY=dev-local-key-change-me
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- LLM Providers ----
LLM_PROVIDER=openai                       # openai | vertexai | local
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
VERTEX_PROJECT_ID=your-gcp-project
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-1.5-pro

# Local inference (vLLM / Triton)
LOCAL_INFERENCE_BASE_URL=http://vllm:8000/v1
LOCAL_INFERENCE_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# ---- Vector Store ----
VECTOR_BACKEND=pinecone                   # pinecone | faiss
PINECONE_API_KEY=pcn-replace-me
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_WARRANTY=warranty-claims
PINECONE_INDEX_DOCS=technical-docs

# ---- Caching / State ----
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=3600

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=warranty-intel-api
PROMETHEUS_METRICS_PATH=/metrics
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=warranty-intel

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls-replace-me
LANGCHAIN_PROJECT=warranty-intelligence-agent

# ---- Evaluation / Governance ----
ENABLE_GUARDRAILS=true
ENABLE_PII_REDACTION=true
HALLUCINATION_THRESHOLD=0.65
GROUNDING_THRESHOLD=0.70

# ---- Ray ----
RAY_ADDRESS=auto

# ---- Feature flags ----
FEATURE_HYBRID_RETRIEVAL=true
FEATURE_RERANKER=true
FEATURE_MCP_TOOLS=true
